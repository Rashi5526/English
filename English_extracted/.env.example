# Copy this file to .env for LOCAL development only (never commit the real .env).
# In production these are set in the Vercel dashboard instead (see README.md).

# Anthropic API key — read server-side by api/nova.ts, never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# VAPID keys authenticate your server to push notification services.
# A ready-to-use pair is provided below — you can keep it or generate your
# own anytime with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BJAHZ3l-vbmoXz70FO8bIehWOVITsUbijTl20oIrIh12Sj9IY7OkX9U3hu5HVvPNa54I8RHgy1cVHZ5Ohn1LCsU
VAPID_PRIVATE_KEY=SPELjZKlmkGfKCdPh8JQFv_OdMJgfeE_nvF_FIEUQks
VAPID_SUBJECT=mailto:you@example.com

# Same public key, exposed to the browser (VITE_ prefix = safe to expose,
# it's the public half of the pair). Must match VAPID_PUBLIC_KEY above.
VITE_VAPID_PUBLIC_KEY=BJAHZ3l-vbmoXz70FO8bIehWOVITsUbijTl20oIrIh12Sj9IY7OkX9U3hu5HVvPNa54I8RHgy1cVHZ5Ohn1LCsU

# A password only you know, so only you can trigger /api/send-notification.
# Make up any long random string.
NOTIFY_SECRET=change-this-to-something-random

# @vercel/kv env vars — auto-added by Vercel when you connect a KV database
# to the project (see README.md). You don't need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
